function kidsTaskContract_(snapshot){
 const text=String(snapshot.guide||'')+'\n'+String(snapshot.reference||'');
 const quote=re=>{const m=re.exec(text);return m?text.slice(Math.max(0,m.index-30),Math.min(text.length,m.index+m[0].length+160)).trim():'';};
 const evidence=[];const has=re=>{const q=quote(re);if(q)evidence.push(q);return !!q;};
 const c={version:'web-task-contract-v1',kind:snapshot.kind,mode:'unknown',capture:'unspecified',fullTextReading:'unspecified',exactWording:'accepted',evidence};
 if(has(/chưa (?:thực hiện|yêu cầu) bài thuyết trình/iu)){c.mode='not_assigned';return c;}
 if(snapshot.kind==='vocabulary'&&has(/(?:nhìn ảnh và tự nói từ|hình ảnh và chữ cái đầu tiên)/iu)){c.mode='picture_recall';c.capture='screen';c.fullTextReading='prohibited';}
 else if(snapshot.kind==='grammar'&&has(/(?:nhìn gợi ý và tự nói|nói (?:trọn|câu hoàn chỉnh))/iu)){c.mode='prompted_sentence';c.capture='screen';}
 else if(['reading','translation','phonics'].includes(snapshot.kind)&&has(/(?:đọc theo|đọc toàn bộ|đọc to|luyện đọc)/iu)){c.mode=snapshot.kind==='translation'?'read_translate':'read_text';c.fullTextReading='allowed';c.exactWording='expected';}
 else if(['peppa','phonicsVideo'].includes(snapshot.kind)&&has(/lồng tiếng|nói thay nhân vật/iu)){c.mode='dubbing';c.exactWording='expected';}
 else if(snapshot.kind==='de'&&has(/(?:nhắc lại đầy đủ và chính xác câu mẫu|dùng đúng lời đã luyện|nói đầy đủ, chính xác những câu)/iu)){c.mode='picture_recitation';c.exactWording='expected';}
 else if(snapshot.kind==='scienceK'&&has(/(?:thuyết trình theo hình ảnh|dùng từng cảnh để trình bày)/iu)){c.mode='explain_pictures';c.exactWording='accepted';}
 else if(['science','critical'].includes(snapshot.kind)&&has(/(?:thuyết trình theo mindmap|dùng mind.?map để thuyết trình|tự thuyết trình theo mindmap|Dựa vào bản đồ tư duy[^.]{0,180}thuyết trình)/iu)){c.mode=has(/(?:Video 2.*?Trả lời|phần trả lời câu hỏi)/iu)?'mindmap_qa':'mindmap_presentation';c.exactWording='own_words';}
 if(['mindmap_qa','mindmap_presentation','explain_pictures'].includes(c.mode))c.fullTextReading='prohibited';
 if(has(/(?:quay chính diện|Camera phải quay chính diện|hướng mặt vào camera|không quay màn hình hoặc không có khuôn mặt con)/iu))c.capture='face';
 else if(has(/(?:bật quay màn hình|quay rõ màn hình|video quay màn hình|có thể quay màn hình)/iu))c.capture='screen';
 if(has(/(?:không mở phụ đề và không đọc chữ|không nhìn phụ đề và không đọc bài đã viết sẵn|không đọc nguyên bài đã viết sẵn)/iu))c.fullTextReading='prohibited';
 c.parentGuidance={picture_recall:'Con mở phần trả bài có hình ảnh và chữ cái gợi ý, rồi tự nói từng từ theo hướng dẫn.',prompted_sentence:'Con nhìn gợi ý và nói câu hoàn chỉnh theo cấu trúc được giao.',read_text:'Con mở đúng bài đọc, đọc đủ và rõ theo hướng dẫn trên web.',read_translate:'Con đọc đủ phần tiếng Anh, sau đó dịch đầy đủ và đúng nghĩa sang tiếng Việt.',dubbing:'Con mở bản tách giọng, dùng giọng của con lồng tiếng đủ lời, đúng nhịp theo bài.',picture_recitation:'Con dùng video không phụ đề làm hình ảnh hỗ trợ và nói đầy đủ, chính xác những câu đã luyện.',explain_pictures:'Con dùng hình ảnh trong video để trình bày đúng nội dung bài, không nhìn phụ đề hoặc đọc bài viết sẵn.',mindmap_qa:'Con nộp đủ video thuyết trình theo mindmap và video trả lời từng câu hỏi được giao.',mindmap_presentation:'Con dùng các nhánh và từ khóa trong mindmap để triển khai đủ ý khi thuyết trình.'}[c.mode]||'Con kiểm tra lại đúng phần hướng dẫn trả bài trên web.';
 return c;
}
function kidsTaskContractInstruction_(snapshot){const c=kidsTaskContract_(snapshot);const focus={
 picture_recall:'Từ vựng Discover/Family: đối chiếu từng hình/từ mục tiêu; gọi đúng tên khác với phát âm đúng. Chỉ đánh giá nhớ nghĩa nếu nhiệm vụ thực có kiểm tra nghĩa. Không ép dịch hoặc đặt câu ngoài đề. Giữ hình để phân biệt hình/chữ cái gợi ý với đáp án đầy đủ.',
 prompted_sentence:'Ngữ pháp Discover/Family: đối chiếu từng câu với gợi ý và cấu trúc được giao; không chỉ chép đáp án mẫu. Chấp nhận câu khác đúng cấu trúc và ý. Rà riêng chia động từ, trợ động từ, be, mạo từ, giới từ và phát âm.',
 read_text:'Đọc Discover/Phonics: được nhìn văn bản/file học. Đối chiếu thứ tự từ/câu, thiếu/thừa/đổi lời, âm đang học, âm cuối, trọng âm, ngắt nghỉ. Không yêu cầu học thuộc hoặc tự diễn đạt; không phạt lỗi ngữ pháp có sẵn trong văn bản. Phonics 1–4 được nhìn chữ và hình trên PDF của cô; đọc được từ/chữ trên PDF là đáp ứng tiêu chí Thuộc mặt chữ, không yêu cầu che chữ hoặc đọc thuộc không nhìn tài liệu. Phonics 1–4 đọc đúng file/PDF của tiết: phân biệt tên chữ, âm chữ, ghép âm, từ và câu theo mẫu thực giao, không thêm nhiệm vụ không có. Phonics có câu vẫn rà âm trong cả câu; không chỉ vài từ riêng lẻ. Khi chỉ có audio, không khẳng định khẩu hình đúng/sai, con chỉ đúng hình, ánh mắt hoặc tư thế; không phạt vì runner đã tách hình khỏi video.',
 read_translate:'Family/đọc-dịch: tách hai nhiệm vụ đọc tiếng Anh và dịch tiếng Việt. Đánh giá âm/nhịp ở phần đọc; đủ ý, đúng nghĩa ở phần dịch. Chấp nhận cách dịch tự nhiên tương đương, không bắt dịch từng chữ hoặc thuộc nguyên văn bản dịch. Thiếu một phần phải ghi cụ thể, không coi phần còn lại là đủ bài.',
 dubbing:'Peppa/Phonics Video: lời theo mẫu, đúng vai/âm mục tiêu, ngữ điệu và thời điểm vào câu. Tách giọng mẫu/nhạc nền với giọng học sinh; giọng mẫu không chứng minh con đọc đúng. Không yêu cầu thay lời bằng lời riêng hay đánh giá hình thể. Không phạt cách nói chuẩn của nhân vật/giọng địa phương như lỗi cấu trúc; lỗi con thực nói khác mẫu vẫn nêu rõ.',
 picture_recitation:'D.E: nói đầy đủ/chính xác lời đã luyện theo hình không phụ đề. Nói giống lời mẫu là đúng yêu cầu. Chấm nội dung/lời, ngữ pháp, phát âm và trình bày thực quan sát; không suy đọc chữ từ việc nói giống mẫu.',
 explain_pictures:'Science K: đúng nội dung khoa học và theo từng cảnh; dùng chính câu đã luyện được chấp nhận. Rà ngữ pháp/phát âm thực nói, không ép đổi câu chữ. Nhận xét cách trình bày chỉ theo hình thật thấy.',
 mindmap_qa:'Science: hai phần riêng, thuyết trình theo từng ý mindmap và trả lời đủ từng câu hỏi cụ thể. Đối chiếu kiến thức/ý, không đòi giống câu mẫu. Nhìn từ khóa mindmap là được phép; câu trả lời đầy đủ không nhất thiết dài. Điểm nghe/script trên web là phần khác, không nhập làm điểm video.',
 mindmap_presentation:'Critical: chỉ chấm video khi đúng tiết thực giao video. Đối chiếu các nhánh mindmap, giải thích và ví dụ theo bài; được nhìn từ khóa/nhánh để triển khai. Không chấm tiết chỉ làm bài giấy/hoàn thiện mindmap như thể thiếu video.'
 };return `YÊU CẦU TRẢ BÀI ĐÃ ĐỐI CHIẾU WEB: ${JSON.stringify(c)}\nTRỌNG TÂM DẠNG BÀI: ${focus[c.mode]||'Chưa đủ yêu cầu trả bài để chấm; giữ kiểm tra.'}
Phân biệt LỜI NÓI và CÁCH THỰC HIỆN: nói đúng nguyên văn câu mẫu không chứng minh đang đọc chữ. D.E cần đầy đủ/chính xác câu mẫu theo hình; Science K chấp nhận dùng đúng câu đã luyện. Không ép đổi từ hay tự sáng tạo để chứng minh thuyết trình. Chỉ ghi visible_reading khi có hình văn bản/phụ đề và hành vi đọc tương ứng thực quan sát. Từ khóa/nhánh mindmap được phép; chỉ nhìn ra ngoài khung, hướng mặt vào máy hoặc nói trôi chảy đều không chứng minh đọc hay thuộc bài. not_determinable là giới hạn quan sát, không tự coi là sai cách làm hoặc trừ điểm.
Khối mindmap/Q&A: đánh giá đủ ý và câu trả lời đúng theo bài; không chặn chỉ vì một câu trùng lời mẫu. Đọc văn bản/đọc dịch/Phonics và lồng tiếng dùng đúng lời là nhiệm vụ, không áp tiêu chí tự sáng tạo hay tương tác máy quay. Không lẫn hướng dẫn LUYỆN (được xem phụ đề) với yêu cầu QUAY NỘP (có thể cấm phụ đề). Với hai video mindmap và Q&A, phân loại và đối chiếu riêng từng tệp; không lấy yêu cầu phần này phạt phần kia. Nếu hợp đồng chưa xác định được nhiệm vụ, giữ kiểm tra trước khi chấm; không suy từ tên dòng sách.`;}
